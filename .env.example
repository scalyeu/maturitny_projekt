# AtletCoach – vzor konfigurácie. Skopíruj ako .env (súbor .env sa do gitu nenahráva).
# Appka beží aj bez .env; kľúče potrebujú len AI chat / AI tréner (Groq) a Strava.

# Flask – tajný kľúč podpisuje prihlasovaciu cookie.
# Ak chýba, vygeneruje sa raz do instance/secret_key. Pri nasadení nastav pevnú dlhú náhodnú hodnotu.
SECRET_KEY=zmen-ma-na-dlhy-nahodny-retazec

# Spúšťanie (predvolené hodnoty; pri nasadení FLASK_DEBUG=0 a ATLETCOACH_RELOAD=0)
FLASK_DEBUG=1
ATLETCOACH_PORT=5001
ATLETCOACH_RELOAD=1
# ATLETCOACH_NO_BROWSER=1          # neotvárať prehliadač pri štarte
# ATLETCOACH_DB_URI=sqlite:////absolutna/cesta/database.db   # iná databáza (predvolene instance/database.db)

# Groq API (zadarmo) – AI chat a AI tréner; získaj na https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Strava API – získaj na https://www.strava.com/settings/api
# (appka beží na porte 5001; rovnaký callback nastav aj v Strave)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REDIRECT_URI=http://localhost:5001/strava/callback
