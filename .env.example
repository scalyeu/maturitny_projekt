# Flask – tajny kluc pre prihlasovacie cookie (ak chyba, vygeneruje sa do instance/secret_key)
SECRET_KEY=zmen-ma-na-dlhy-nahodny-retazec

# Strava API – ziskaj na https://www.strava.com/settings/api (appka bezi na porte 5001)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REDIRECT_URI=http://localhost:5001/strava/callback

# Groq API (zadarmo) – ziskaj na https://console.groq.com
GROQ_API_KEY=your_groq_api_key
